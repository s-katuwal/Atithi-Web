# Copy this file to .env.local and fill in your values:  cp .env.example .env.local
# .env.local is git-ignored, so your secrets stay off GitHub.
# Settings saved in Admin → Settings & email take priority over these.

# --- Server ---
PORT=3000
# Only used on the very first run to create the admin account
# ADMIN_PASSWORD=change-me-please

# --- Database: Supabase (required) ---
# Supabase dashboard → your project → Connect → "Transaction pooler" → copy the URI and put your database password in it.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --- Photo storage: Supabase Storage (recommended; required on Vercel) ---
# Supabase dashboard → Project Settings → API Keys. Use the SECRET key (sb_secret_…) or the legacy service_role key.
# Server-only: never put this key in browser code. A public "uploads" bucket is created automatically.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here

# --- Email (Resend) ---
RESEND_API_KEY=re_your_api_key_here
# Must be an address on a domain verified in Resend (or onboarding@resend.dev for testing)
MAIL_FROM=bookings@atithi.com.np
MAIL_FROM_NAME=Atithi Restro & Lodge
# Staff who get new-booking alerts (comma separated)
NOTIFY_EMAIL=owner@example.com
# Public website address, used for the "manage my booking" link in emails
SITE_URL=https://atithi.com.np

# --- Optional SMTP fallback (only used when RESEND_API_KEY is empty) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-app-password
